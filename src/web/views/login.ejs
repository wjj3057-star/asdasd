<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0a0f0c" />
  <title>관리자 로그인</title>
  <link rel="stylesheet" href="/static/style.css" />
  <% if (captchaMode === 'turnstile') { %>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="login-logo">M</div>
      <span class="eyebrow"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.9 5.8L20 9l-5 3.2L16.5 19 12 15.4 7.5 19 9 12.2 4 9l6.1-1.2z"/></svg> STORE OPERATION</span>
      <h1 class="page-title" style="font-size:26px; margin:14px 0 8px">관리자 대시보드</h1>
      <p class="muted" style="margin:0 0 8px">보안 확인 후 디스코드 계정으로 로그인하세요.<br/>관리자로 등록된 계정만 접근할 수 있습니다.</p>
      <% if (error) { %><div class="alert err" style="margin-top:16px"><%= error %></div><% } %>

      <form method="post" action="/login/start" style="margin-top:18px; text-align:left">
        <% if (captchaMode === 'turnstile') { %>
          <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark" style="display:flex; justify-content:center"></div>
        <% } else { %>
          <label style="margin-top:0">🔐 보안 문자 입력</label>
          <div class="captcha-box">
            <img id="captchaImg" src="/captcha/image" alt="captcha" width="190" height="64" />
            <button type="button" class="btn dark sm" title="새로고침" onclick="document.getElementById('captchaImg').src='/captcha/image?t='+Date.now()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
            </button>
          </div>
          <input type="text" name="captcha" placeholder="이미지의 문자 5자리" required autocomplete="off"
                 autocapitalize="characters" maxlength="5" style="margin-top:10px; text-align:center; letter-spacing:.35em; font-weight:800; font-size:18px" />
        <% } %>

        <button type="submit" class="btn green block" style="margin-top:16px; padding:16px">
          <svg viewBox="0 0 24 24" fill="currentColor" style="width:20px;height:20px"><path d="M19.6 5.3A17 17 0 0 0 15.3 4l-.2.4a15.7 15.7 0 0 1 4 1.3 13.7 13.7 0 0 0-11 0 15.7 15.7 0 0 1 4-1.3L11.9 4a17 17 0 0 0-4.3 1.3C4.6 9.7 3.8 14 4.2 18.2a16.6 16.6 0 0 0 5 2.6l.4-.6a11 11 0 0 1-1.7-.8l.4-.3a11.9 11.9 0 0 0 10.2 0l.4.3c-.5.3-1.1.6-1.7.8l.4.6a16.6 16.6 0 0 0 5-2.6c.5-4.9-.8-9.2-3-12.9zM9.7 15.6c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2zm4.6 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2z"/></svg>
          Discord로 로그인
        </button>
      </form>
    </div>
  </div>
</body>
</html>
