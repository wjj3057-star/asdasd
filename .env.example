# ===== Discord 봇 설정 =====
# 디스코드 개발자 포털(https://discord.com/developers/applications)에서 발급
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_CLIENT_SECRET=your-oauth-client-secret
# 봇을 사용할 서버(길드) ID - 슬래시 커맨드 즉시 등록용 (비워두면 글로벌 등록)
GUILD_ID=

# 봇 소유자(슈퍼관리자) 디스코드 유저 ID (쉼표로 여러 명). 라이선스 키 발급 + 전체 서버 관리 권한.
# 미지정 시 ADMIN_IDS 로 폴백.
OWNER_IDS=123456789012345678
# (구버전 호환) 관리자 유저 ID. OWNER_IDS 가 없으면 이 값이 소유자로 사용됩니다.
ADMIN_IDS=123456789012345678

# ===== 웹 대시보드 설정 =====
WEB_PORT=3000
# 외부에서 접속 가능한 대시보드 주소 (OAuth 콜백에 사용). 예) https://shop.example.com
WEB_BASE_URL=http://localhost:3000
# 세션 암호화 키 (아무 랜덤 문자열로 변경)
SESSION_SECRET=change-me-to-a-long-random-string

# ===== 로그인 캡차 (선택) =====
# 미설정 시 자체 SVG 캡차가 동작합니다. Cloudflare Turnstile 을 쓰려면 아래 두 키 설정.
# https://dash.cloudflare.com/ → Turnstile 에서 발급
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===== 결제/충전 웹훅 보안 =====
# 은행 입금 알림 포워딩 앱 / 코인 웹훅이 사용할 공유 시크릿
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# ===== 코인 충전 (선택) =====
# 코인 자동 확인 폴링에 사용할 블록체인 API. 미설정 시 웹훅/수동 승인만 동작.
# 예: TRON(USDT-TRC20) 지갑 주소
COIN_WALLET_ADDRESS=
# TronGrid API Key (선택, USDT-TRC20 자동확인용)
TRONGRID_API_KEY=
